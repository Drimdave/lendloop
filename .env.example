# Copy to .env.local (Next.js) and .env (docker compose). Never commit the real files.

# --- Clerk (https://dashboard.clerk.com) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# --- Convex ---
# Written by `npx convex dev`. HTTP actions are served from the same deployment on the
# .convex.site domain (port 3211 for a local deployment).
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_SITE_URL=https://your-deployment.convex.site

# --- n8n (read by docker compose) ---
# Generate each secret with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=
N8N_WEBHOOK_SECRET=
N8N_CALLBACK_SECRET=
# "email" sends mail through the SMTP credential (MailHog in docker compose);
# "log" only writes recipient and subject to the n8n log.
NOTIFY_CHANNEL=email
MAIL_FROM=lendloop@example.test

# The values below are NOT env vars of the Next.js app. Set them on the Convex deployment:
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN https://your-instance.clerk.accounts.dev
#   npx convex env set ADMIN_EMAILS you@example.com
#   npx convex env set N8N_WEBHOOK_URL http://localhost:5678/webhook/lendloop-request
#   npx convex env set N8N_WEBHOOK_SECRET <same value as above>
#   npx convex env set N8N_CALLBACK_SECRET <same value as above>
